# 中转服务器环境变量配置
# 复制此文件为 .env 并填入实际值

# 阿里云 ACR 镜像信息（CI/CD 自动注入，此处仅供参考）
IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_NAMESPACE=<your-namespace>
IMAGE_NAME=new-api
IMAGE_TAG=latest

# 数据库密码（⚠️ 必须修改！）
PG_PASSWORD=your-strong-password-here

# Redis 密码（⚠️ 必须修改！）
REDIS_PASSWORD=your-strong-password-here
